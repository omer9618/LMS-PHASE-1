# /opt/lms/<environment>/backup.env - copy from this file (chmod 600). Read by
# scripts/backup.sh and scripts/restore.sh. See docs/BACKUP_RESTORE.md.
#
# Use a bucket that is NOT the uploads bucket, with its own key limited to it (List, Get, Put,
# Delete). Turn on bucket versioning or object lock if the provider has it, so a stolen server
# key cannot erase history.

BACKUP_S3_BUCKET=
# Key prefix inside the bucket. One prefix per environment.
BACKUP_S3_PREFIX=postgres/lms-staging
# auto for Cloudflare R2; the bucket's region for AWS.
BACKUP_S3_REGION=auto
# Empty for AWS S3. R2: https://<account>.r2.cloudflarestorage.com. MinIO/Spaces: their URL.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Dumps older than this are deleted from the bucket, but never the newest BACKUP_MIN_KEEP.
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP=7

# The newest few dumps are also kept on the server, for a fast restore.
BACKUP_LOCAL_DIR=/var/backups/lms-staging
BACKUP_LOCAL_KEEP=3

# Optional: a URL pinged after each successful backup (healthchecks.io, Uptime Kuma push
# monitor...). It alerts when the pings stop, which catches a silently broken cron.
BACKUP_HEARTBEAT_URL=

# aws-cli image used for uploads. Pinned so a new CLI release cannot change behaviour.
BACKUP_AWS_CLI_IMAGE=amazon/aws-cli:2.27.0
