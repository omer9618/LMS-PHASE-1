# /opt/lms/<environment>/api.env - copy from this file (chmod 600). Never commit the copy.
# The API validates all of this at startup (src/config/env.schema.ts) and refuses to start in
# production while anything is missing or still a dev default. Where each provider value comes
# from: docs/INTEGRATIONS.md. Set by compose.yml, so not here: DATABASE_URL, NODE_ENV, PORT,
# TRUST_PROXY_HOPS (2: Caddy -> Next.js /api rewrite -> API).

LOG_LEVEL=info

# Public URLs. APP = the web app (links in emails), API = this API (as Caddy serves it).
APP_PUBLIC_URL=https://staging.example.com
API_PUBLIC_URL=https://api.staging.example.com

# Sessions. __Host- cookies require Secure, path=/ and no Domain: what the API sets.
SESSION_COOKIE_NAME=__Host-lms_session
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720
# The browser reaches the API through the web app's /api rewrite, so the cookie is first-party
# on the web origin and lax is right.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# MFA: `openssl rand -base64 32`. Changing it forces every admin to re-enrol. Keep a copy in
# the password manager: a database restore is useless for admins without it.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=LMS

# Email (SMTP).
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM="LMS <no-reply@example.com>"

# File storage (S3-compatible, private bucket). Staging and production use separate buckets.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# `openssl rand -base64 48`
STORAGE_SIGNING_SECRET=

# Captcha (Cloudflare Turnstile).
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=

# Video (Bunny Stream). Staging and production use separate libraries.
VIDEO_PROVIDER=bunny
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_READONLY_API_KEY=
BUNNY_TOKEN_AUTH_KEY=

# Scheduled jobs (order expiry, purges, payout auto-accept). Run exactly one API replica.
JOBS_ENABLED=true

# First install only, read by `docker compose run --rm migrate npx prisma db seed`.
# Remove SEED_ADMIN_PASSWORD from this file after the first admin has signed in.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
