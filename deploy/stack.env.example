# /opt/lms/<environment>/.env - copy from this file (chmod 600). Read by deploy/compose.yml.
# Not the API's configuration: that is api.env.

# lms-staging or lms-production. Also the Compose project name and the API's alias on the
# edge network (<STACK_NAME>-api), which the Caddy site file points at.
STACK_NAME=lms-staging

# Images built by .github/workflows/deploy.yml. GHCR names are lowercase.
API_IMAGE=ghcr.io/omer9618/lms-phase-1-api
TOOLS_IMAGE=ghcr.io/omer9618/lms-phase-1-tools
WEB_IMAGE=ghcr.io/omer9618/lms-phase-1-web

# Services beyond api/postgres that run here. `web` = the Next.js app, deployed with the API.
COMPOSE_PROFILES=web

# The release currently deployed (a commit SHA). Leave empty: deploy.sh writes these.
# WEB_TAG stays empty (the web app follows API_TAG) unless a web roll failed.
API_TAG=
PREVIOUS_API_TAG=
WEB_TAG=

# Database password: `openssl rand -hex 32` (hex, so it is safe inside a URL).
# Only used on the internal Docker network. Changing it later needs ALTER ROLE as well.
POSTGRES_PASSWORD=
