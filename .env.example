# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Dev database (see README "Local database").
DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms?schema=public"

# Separate database for e2e tests. Migrated and seeded automatically by `npm run test:e2e`.
TEST_DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms_test?schema=public"
