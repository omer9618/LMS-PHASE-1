# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Dev database (see README "Local database").
DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms?schema=public"

# Separate database for e2e tests. Migrated and seeded automatically by `npm run test:e2e`.
TEST_DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms_test?schema=public"

# Sessions (#12). Server-side sessions; the cookie holds an opaque token.
# Production: SESSION_COOKIE_NAME=__Host-lms_session, COOKIE_SECURE=true (enforced).
SESSION_COOKIE_NAME=lms_session
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720
COOKIE_SAMESITE=lax
# COOKIE_SECURE defaults to true in production, false elsewhere (plain http://localhost).
