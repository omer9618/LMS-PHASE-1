# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Reverse proxies in front of the app (0 locally, 1 behind nginx/caddy on the VPS).
TRUST_PROXY_HOPS=0

# Dev database (see README "Local database").
DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms?schema=public"

# Separate database for e2e tests. Migrated and seeded automatically by `npm run test:e2e`.
TEST_DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms_test?schema=public"

# Sessions (#12). Server-side sessions; the cookie holds an opaque token.
# Production: SESSION_COOKIE_NAME=__Host-lms_session, COOKIE_SECURE=true (enforced).
SESSION_COOKIE_NAME=lms_session
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720
COOKIE_SAMESITE=lax
# COOKIE_SECURE defaults to true in production, false elsewhere (plain http://localhost).

# MFA (#16). Production: a real key from `openssl rand -base64 32`. Changing it invalidates
# every enrolled authenticator, so treat it like a database password.
# MFA_ENCRYPTION_KEY=
MFA_ISSUER=LMS

# Seed (prisma/seed.ts). Dev/test defaults apply only when NODE_ENV != production.
# In production SEED_ADMIN_PASSWORD is required and the dev teachers are not created.
# SEED_ADMIN_EMAIL=admin@lms.local
# SEED_ADMIN_PASSWORD=
# SEED_TEACHER_PASSWORD=

# Public URLs: the web app (links in emails) and this API (local file links).
APP_PUBLIC_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000

# Email (#110). log = print emails (with links) to the console. Production: smtp + SMTP_URL.
EMAIL_TRANSPORT=log
# SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM="LMS <no-reply@lms.local>"

# File storage (#19). local = files under .storage/. Production: s3 + S3_* + STORAGE_SIGNING_SECRET.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Captcha on public forms (#18). disabled = dev/tests (the token "invalid-captcha" still fails).
# Production: turnstile + CAPTCHA_SECRET_KEY from the Cloudflare dashboard.
CAPTCHA_PROVIDER=disabled
# CAPTCHA_SECRET_KEY=

# Scheduled jobs (purges, order expiry, payout auto-accept).
JOBS_ENABLED=true
